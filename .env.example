# Copy to .env and fill. Never commit .env.
# Decoy service-account tokens (Renad creates them in the DECOY Gitea / Verdaccio).
DECOY_GIT_TOKEN=
DECOY_GIT_USER=
DECOY_NPM_TOKEN=
# Upstreams the gateway switches to for bait traffic.
DECOY_GIT_URL=http://gitea-decoy:3000
DECOY_NPM_URL=http://verdaccio-decoy:4873
# LLM (optional). Empty = rules-only analysis.
LLM_API_KEY=
LLM_MODEL=
