# Copy to .env and fill. Never commit .env.
# Decoy service-account values. `bash env/setup.sh` creates them in the DECOY Gitea / Verdaccio and writes them here.
DECOY_GIT_TOKEN=
DECOY_GIT_USER=
DECOY_NPM_TOKEN=
# Upstreams the gateway switches to for bait traffic.
DECOY_GIT_URL=http://gitea-decoy:3000
DECOY_NPM_URL=http://verdaccio-decoy:4873
# LLM (optional). Empty = rules-only analysis. Any OpenAI-compatible chat API:
#   GLM (Zhipu): LLM_BASE_URL = your platform's .../api/paas/v4    Grok (xAI): https://api.x.ai/v1
LLM_BASE_URL=
LLM_MODEL=
LLM_API_KEY=
# Empty = low (fast). Set "none" if your model rejects the reasoning_effort field.
LLM_REASONING_EFFORT=
